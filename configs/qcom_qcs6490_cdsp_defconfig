# QCS6490 CDSP (Rubik Pi 3).
#
# The root filesystem is an external, gzip-compressed cpio archive.  Keeping
# it separate from vmlinux leaves platform bootloader and image-packaging
# integration outside Buildroot's scope.
BR2_hexagon=y
BR2_HEXAGON_v68=y
BR2_STATIC_LIBS=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_CLANG=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://artifacts.codelinaro.org/artifactory/codelinaro-toolchain-for-hexagon/23.1.0-rc1/clang+llvm-23.1.0-rc1-cross-hexagon-unknown-linux-musl.tar.zst"
BR2_TOOLCHAIN_EXTERNAL_REL_BIN_PATH="x86_64-ubuntu-22.04/bin"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="hexagon-unknown-linux-musl"
BR2_TOOLCHAIN_EXTERNAL_CLANG_23_0=y
BR2_TOOLCHAIN_EXTERNAL_GCC_12=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_13=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y

# ld.lld from this toolchain emits duplicate named constants for BusyBox;
# use the toolchain's supported ELD linker instead.
BR2_HEXAGON_USE_ELD=y

BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_ROOTFS_DEVICE_CREATION_STATIC=y
BR2_ROOTFS_OVERLAY="board/qcom/qcs6490-cdsp/rootfs-overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/qcom/qcs6490-cdsp/post-image.sh"

# A static BusyBox shell is all the recovery/initramfs needs.  Do not add the
# large development and network package set used by the QEMU CDSP image.
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="board/qcom/qcs6490-cdsp/busybox.fragment"
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://git.kernel.org/pub/scm/linux/kernel/git/bcain/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="bcain-qcs6490-sept27-2026"
BR2_LINUX_KERNEL_DEFCONFIG="qcs6490_cdsp"
BR2_LINUX_KERNEL_VMLINUX=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="qcs6490-cdsp"
