# Do NOT embed the buildroot rootfs into the kernel. The rootfs now lives on
# a persistent virtio-blk disk (/dev/vda, ext2), mounted directly as root via
# root=/dev/vda below -- no initrd needed. Keep CONFIG_INITRAMFS_SOURCE empty
# so no rootfs is baked into vmlinux (BR2_TARGET_ROOTFS_INITRAMFS, which used
# to set this, is no longer selected -- this guards against the base
# defconfig ever reintroducing it).
CONFIG_INITRAMFS_SOURCE=""

# Console: the Qualcomm QUP/GENI serial engine, not the PL011.
#
# QEMU's "virt" hexagon machine emits a GENI serial engine (compatible
# "qcom,geni-debug-uart") under a QUP wrapper node, and makes it
# /aliases/serial0 + /chosen/stdout-path; the PL011 is /aliases/serial1.
# qcom_geni_serial names its console ports "ttyMSM<of_alias_get_id(serial)>",
# so the GENI UART is ttyMSM0 (the PL011 is ttyAMA1 -- ttyAMA*1*, not
# ttyAMA0, precisely because of that serial1 alias).
#
# Deliberately no "earlycon": it would resolve from /chosen/stdout-path onto
# this same GENI UART (OF_EARLYCON_DECLARE(qcom_geni, "qcom,geni-debug-uart")),
# but hexagon's fixmap support is not far enough along to carry
# FIX_EARLYCON_MEM_BASE through boot -- see ./qup_uart_console.md. Nothing is
# actually lost: the angel semihosting bootconsole (angel0) already covers the
# window before ttyMSM0 registers at ~2.2s, and printk replays the ring buffer
# onto ttyMSM0 at handover.
#
# root=/dev/vda mounts the persistent virtio-blk ext2 disk directly as root;
# rootwait blocks boot until the virtio-blk driver probes the device instead
# of panicking with "VFS: Unable to mount root fs".
CONFIG_CMDLINE="console=ttyMSM0 debug mem=892M lpj=89124080 root=/dev/vda rw rootwait"

# The QUP/GENI console stack. The kernel's own hexagon qemu_defconfig already
# turns these on, but pin them here so the console= above cannot be silently
# left without a driver if that defconfig changes. QCOM_GENI_SE drives the QUP
# wrapper (the DT parent) and SERIAL_QCOM_GENI[_CONSOLE] the serial engine
# itself; both are reachable on hexagon because CONFIG_ARCH_QCOM=y.
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

# Enable the common clock framework so the DT "apb-pclk" fixed-clock node --
# which QEMU's virt machine emits as the PL011's "apb_pclk"/"uartclk" supplier
# (clocks = <&apb-pclk>), exactly like the arm64 virt machine does -- actually
# gets a driver (of_fixed_clk_setup) that binds it and registers the clock.
# The GENI UART hangs off the same fixed clock (its "se" clock), so this is
# now a prerequisite for the console above, not just for the PL011.
#
# Without COMMON_CLK there is no fixed-rate clock driver, so that platform
# device sits permanently unbound (DL_DEV_NO_DRIVER). fw_devlink then blocks
# the PL011 (its clock consumer) from probing until driver_deferred_probe_timeout
# expires -- a fixed ~10s stall during which the console never comes up and all
# of init/rcS runs with stdio redirected to /dev/null (hence no boot messages).
# The interrupt-controller supplier link does NOT cause this: irq_domain
# creation marks that fwnode FWNODE_FLAG_INITIALIZED, which fw_devlink honours.
#
# With COMMON_CLK the fixed-clock binds at ~1.5s and the PL011 probes right
# after (~2.7s) instead of at ~12.7s.
CONFIG_COMMON_CLK=y

# Enable eBPF.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_CGROUP_BPF=y

# GLINK-over-ivshmem inter-VM RPC stack.
#
# The ivshmem mailbox provides the doorbell/interrupt side, QCOM_SMEM the
# shared-memory item allocator, and RPMSG_QCOM_GLINK_SMEM the GLINK transport
# built on top of both. HWSPINLOCK(_QCOM) is a hard dependency of QCOM_SMEM,
# which takes a hwspinlock around every SMEM allocation.
CONFIG_MAILBOX=y
CONFIG_IVSHMEM_MBOX=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_SMEM=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_ECHO=y
CONFIG_RPMSG_NET=y
CONFIG_FASTRPC_DEVICE=y

# QRTR (Qualcomm IPC router) over the SMD/GLINK rpmsg transport.
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
