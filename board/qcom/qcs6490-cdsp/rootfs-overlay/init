#!/bin/sh
# The CDSP's initramfs is intentionally a recovery shell, not a general
# Buildroot installation.  The kernel command line selects this as rdinit.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
hostname qcs6490-cdsp
echo "QCS6490 CDSP Buildroot recovery shell"
exec /bin/sh
